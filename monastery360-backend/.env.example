# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# JWT Secret
JWT_SECRET=monastery360-super-secret-key-change-in-production

# Database Configuration (for future use)
DATABASE_URL=postgresql://username:password@localhost:5432/monastery360
MONGODB_URL=mongodb://localhost:27017/monastery360

# Third-party API Keys (for future use)
OPENAI_API_KEY=your-openai-api-key
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token
STRIPE_SECRET_KEY=your-stripe-secret-key
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Cloud Storage (for future use)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=monastery360-assets
AWS_REGION=us-east-1

# Email Configuration (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password